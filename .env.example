# Copia este fichero a .env y pon los valores reales. El .env NO se versiona.
# Quarkus lo lee automaticamente y sobrescribe a application.properties (ordinal 295 vs 250).
# docker-compose tambien lo lee para levantar Postgres, asi que un solo fichero cubre ambos.

# --- Postgres (contenedor) ---------------------------------------------------
POSTGRES_DB=hexarch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Datasource de la app ----------------------------------------------------
# Deben cuadrar con las tres variables de arriba.
QUARKUS_DATASOURCE_USERNAME=postgres
QUARKUS_DATASOURCE_PASSWORD=postgres
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/hexarch

# --- HTTP --------------------------------------------------------------------
QUARKUS_HTTP_PORT=8080
# Tope del cuerpo de una peticion. Debe superar 8 MiB * 1.33 (base64 de levelData).
HTTP_MAX_BODY_SIZE=16M

# --- JWT ---------------------------------------------------------------------
# El issuer debe ser identico en emision y verificacion.
HEXARCH_JWT_ISSUER=https://hexarch.org/issuer
HEXARCH_JWT_EXPIRATION_SECONDS=3600

# Solo en produccion: en dev/test Quarkus genera el par RSA en memoria.
#   openssl genrsa -out rsaPrivateKey.pem 2048
#   openssl rsa -pubout -in rsaPrivateKey.pem -out publicKey.pem
#   openssl pkcs8 -topk8 -nocrypt -inform pem -in rsaPrivateKey.pem -outform pem -out privateKey.pem
JWT_PRIVATE_KEY_LOCATION=privateKey.pem
JWT_PUBLIC_KEY_LOCATION=publicKey.pem
