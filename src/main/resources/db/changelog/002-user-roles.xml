<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="hexarch" id="002-1-create-user-role-type">
        <sql>
            CREATE TYPE user_role AS ENUM ('PLAYER', 'MODERATOR', 'ADMIN');
        </sql>
        <rollback>
            <sql>DROP TYPE IF EXISTS user_role;</sql>
        </rollback>
    </changeSet>

    <changeSet author="hexarch" id="002-2-add-users-role">
        <addColumn tableName="users">
            <column name="role" type="user_role" defaultValue="PLAYER">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <createIndex tableName="users" indexName="idx_users_role">
            <column name="role"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
